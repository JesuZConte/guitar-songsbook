      "type": "verse",
      "number": 3,
      "lines": [
        {
          "text": "En Roma, Lima y en Santander",
          "chords": [
            { "chord": "B", "position": 0 },
            { "chord": "E", "position": 15 }
          ]
        },
        {
          "text": "La gente de tu edad no sabe qué hacer",
          "chords": [
            { "chord": "D", "position": 0 },
            { "chord": "A", "position": 24 }
          ]
        },
        {
          "text": "Santiago, Asunción y también Buenos Aires",
          "chords": [
            { "chord": "B", "position": 4 },
            { "chord": "E", "position": 22 }
          ]
        },
        {
          "text": "Bueno, las cosas no están que arden",
          "chords": [
            { "chord": "D", "position": 0 },
            { "chord": "A", "position": 22 }
          ]
        },
        {
          "text": "Sangre latina necesita el mundo",
          "chords": [
            { "chord": "B", "position": 0 },
            { "chord": "E", "position": 19 }
          ]
        },
        {
          "text": "Roja, furiosa y adolescente",
          "chords": [
            { "chord": "D", "position": 0 },
            { "chord": "A", "position": 17 }
          ]
        },
        {
          "text": "Sangre latina necesita el planeta",
