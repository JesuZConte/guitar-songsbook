      ]
    },
    {
      "type": "verse",
      "number": 2,
      "lines": [
        {
          "text": "Las juventudes cacarearon bastante",
          "chords": [
            { "chord": "B", "position": 0 },
            { "chord": "E", "position": 18 }
          ]
        },
        {
          "text": "Y no convencen ni por solo un instante",
          "chords": [
            { "chord": "D", "position": 0 },
            { "chord": "A", "position": 25 }
          ]
        },
        {
          "text": "Pidieron comprensión, amor y paz",
          "chords": [
            { "chord": "B", "position": 4 },
            { "chord": "E", "position": 22 }
          ]
        },
        {
          "text": "Con frases hechas muchos años atrás",
          "chords": [
            { "chord": "D", "position": 0 },
            { "chord": "A", "position": 25 }
          ]
        },
        {
          "text": "Deja la inercia de los setenta, abre los ojos, ponte de pie",
          "chords": [
            { "chord": "B", "position": 0 },
            { "chord": "E", "position": 17 },
            { "chord": "D", "position": 32 },
            { "chord": "A", "position": 47 }
          ]
        },
        {
          "text": "Escucha el latido, sintoniza el sonido",
          "chords": [
            { "chord": "B", "position": 0 },
            { "chord": "E", "position": 19 }
          ]
        },
        {
          "text": "Agudiza tus sentidos, date cuenta que estás vivo",
          "chords": [
            { "chord": "D", "position": 4 },
            { "chord": "A", "position": 23 }
          ]
        }
