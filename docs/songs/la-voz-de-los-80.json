    {
      "type": "verse",
      "number": 1,
      "lines": [
        {
          "text": "Algo grande está naciendo",
          "chords": [
            { "chord": "B", "position": 0 },
            { "chord": "E", "position": 15 }
          ]
        },
        {
          "text": "En la década de los ochenta",
          "chords": [
            { "chord": "D", "position": 0 },
            { "chord": "A", "position": 16 }
          ]
        },
        {
          "text": "Ya se siente la atmósfera",
          "chords": [
            { "chord": "B", "position": 0 },
            { "chord": "E", "position": 16 }
          ]
        },
        {
          "text": "Saturada de aburrimiento",
          "chords": [
            { "chord": "D", "position": 0 },
            { "chord": "A", "position": 12 }
          ]
        },
        {
          "text": "Los hippies y los punk tuvieron la ocasión",
          "chords": [
            { "chord": "B", "position": 4 },
            { "chord": "E", "position": 23 }
          ]
        },
        {
          "text": "De romper el estancamiento",
          "chords": [
            { "chord": "D", "position": 0 },
            { "chord": "A", "position": 13 }
          ]
        },
        {
          "text": "En las garras de la comercialización",
          "chords": [
            { "chord": "B", "position": 0 },
            { "chord": "E", "position": 20 }
          ]
        },
        {
          "text": "Murió toda la buena intención",
          "chords": [
            { "chord": "D", "position": 0 },
            { "chord": "A", "position": 14 }
          ]
        }
      ]
    },
    {
      "type": "outro",
      "number": 1,
